# Cohere API Key — used for generating embeddings (embed-english-v3.0 model)
COHERE_API_KEY="your_cohere_api_key"

# Qdrant Cloud credentials — vector database for semantic search
QDRANT_API_KEY="your_qdrant_api_key"
QDRANT_URL="your_qdrant_cluster_url"  # e.g. https://xxxx.qdrant.io:6333

# OpenAI API Key — used by the RAG Agent (gpt-4o-mini model)
OPENAI_API_KEY="your_openai_api_key"

# Qdrant collection name (default: ragbot_embedding)
COLLECTION_NAME="ragbot_embedding"
